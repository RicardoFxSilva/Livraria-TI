@{
    ViewData["Title"] = "Detalhes do Livro";
}

<head>
    <link rel="stylesheet" type"text/css" href="Detalhe.cshtml.css" />
</head>
<body>
    <!-- Product section-->
    <section class="py-5">
        <div class="container px-4 px-lg-5 my-5">
            <div class="row gx-4 gx-lg-5 align-items-center">
                <div class="col-md-6">
                    <img src="~/Images/ImgLivros/@(ViewData["id"]).png"
                         alt="Imagem de Livro"
                         class="img-fluid">
                </div>
                <div class="col-md-6">
                    <h1 class="display-5 fw-bolder">Texto antes de base de dados teehee</h1>
                    <div class="fs-5 mb-5">
                        <span class="text-decoration-line-through">Preço: 30.00€</span>
                        <br />
                        <span>Preço: <strong>25.00€</strong></span>
                    </div>
                    <p class="lead">Mega livro</p>
                    <div class="d-flex">
                        <input class="form-control text-center me-3" id="inputQuantity" type="num" value="1" style="max-width: 3rem" />
                        <button class="btn btn-outline-warning text-black flex-shrink-0" type="button">
                            <i class="bi-cart-fill me-1"></i>
                            Adicionar ao Carrinho
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>


