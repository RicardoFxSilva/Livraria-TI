@{
    ViewData["Title"] = "Detalhes do Livro";
}

<head>
    <link rel="stylesheet" type"text/css" href="Detalhe.cshtml.css" />
</head>

<div class="container">
    <header>
        <h1>Detalhes do Livro</h1>
    </header>

    <main class="book-details">
        <div class="book-image">
            <img src="Imagem do Livro" alt="Imagem do Livro">
        </div>
        <div class="book-info">
            <h2>Titulo</h2>
            <p class="author">Autor: <strong>Autor</strong></p>
            <p class="price">Preço: Preco</p>
            <p class="description">Descricao</p>
            <button class="btn buy-now">Comprar Agora</button>
            <button class="btn add-to-cart">Adicionar ao Carrinho</button>
        </div>
    </main>
</div>

