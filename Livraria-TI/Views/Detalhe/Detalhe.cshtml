@{
    ViewData["Title"] = "Detalhes do Livro";
}

@model Livraria_TI.Models.ViewModels.Livro.LivroIndexViewModel;
<head>
    <link rel="stylesheet" href="~/css/Detalhe.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <header>
            <h1>Detalhes do Livro</h1>
        </header>
        <main class="book-details">
            @foreach (var livro in Model.livros)
            {
                <div class="book-image">
                    <img src="~/Images/ImgLivros/@livro.Capa"
                         alt="@livro.Titulo"
                         class="img-fluid">
                </div>
                <div class="book-info">
                    <h2>@livro.Titulo</h2>
                    <p class="author">Autor: <strong></strong></p>
                    <p class="price">Preço: @livro.Preco</p>
                    <p class="description">@livro.Descricao</p>
                    <form method="post">
                        <button class="btn add-to-cart">Adicionar ao Carrinho</button>
                    </form>
                </div>
            }
        </main>
    </div>
</body>


