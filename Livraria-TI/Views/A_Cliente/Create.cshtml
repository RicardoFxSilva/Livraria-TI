@{
    ViewData["Title"] = "Criar Categorias";
}

@model Livraria_TI.Models.ViewModels.Livro.LivroCreateViewModel;

@section Css {



}


<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">

                <div class="card card-success">
                    <div class="card-header">
                        <h3 class="card-title">
                            Dados da Configuraçao
                        </h3>

                        <div class="card-tools">
                            <!-- This will cause the card to maximize when clicked -->
                            <button type="button" class="btn btn-tool" data-card-widget="maximize"><i class="fas fa-expand"></i></button>

                            <!-- This will cause the card to collapse when clicked -->
                            <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                        </div>

                    </div>
                    <!-- /.card-header -->

                    <form method="post">
                        <div class="card-body">

                            <div class="form-group">
                                <label for="Description">Nome do Produto</label>
                                <input type="text" asp-for="Titulo" class="form-control" placeholder="Introduza o nome">
                                <input type="number" asp-for="Preco" class="form-control" placeholder="Introduza o preco">
                                <input type="text" asp-for="descricao" class="form-control" placeholder="Introduza a descricao">
                                <input type="file" asp-for="Capa" class="form-control" placeholder="Introduza a capa">
                                <input type="text" asp-for="Editora" class="form-control" placeholder="Introduza a editora">
                            </div>

                        </div>

                        <div class="card-footer">
                            <div class="float-left">
                                <a href="@Url.Action("Index", "A_Produto")" class="btn btn-dark"><i class="fa fa-arrow-left"></i> Voltar</a>
                            </div>
                            <div class="float-right">
                                <button type="submit" class="btn btn-success"><i class="fas fa-plus"></i> OK</button>
                            </div>
                        </div>
                    </form>

                </div>

            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>
<!-- /.content -->
@section Scripts {



}