@{
    ViewData["Title"] = "Criar Categorias";
}

@model Livraria_TI.Models.ViewsModels.Produto.ProdutoEditViewModel;

@section Css {



}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Criar Produto</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a class="text-success" href="@Url.Action("Index", "Home")">Home</a></li>
                    <li class="breadcrumb-item"><a class="text-success" href="@Url.Action("Index", "Produto")">Produtos</a></li>
                    <li class="breadcrumb-item active">Criar</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">

                <div class="card card-success">
                    <div class="card-header">
                        <h3 class="card-title">
                            Dados da Configuraçao
                        </h3>

                        <div class="card-tools">
                            <!-- This will cause the card to maximize when clicked -->
                            <button type="button" class="btn btn-tool" data-card-widget="maximize"><i class="fas fa-expand"></i></button>

                            <!-- This will cause the card to collapse when clicked -->
                            <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                        </div>

                    </div>
                    <!-- /.card-header -->

                    <form method="post">
                        <div class="card-body">

                            <div class="form-group">
                                <label for="Description">Nome do Produto</label>
                                <input type="text" asp-for="Titulo" class="form-control" placeholder="Introduza o nome">
                            </div>

                        </div>

                        <div class="card-footer">
                            <div class="float-left">
                                <a href="@Url.Action("Index", "Produto")" class="btn btn-dark"><i class="fa fa-arrow-left"></i> Voltar</a>
                            </div>
                            <div class="float-right">
                                <button type="submit" class="btn btn-success"><i class="fas fa-plus"></i> OK</button>
                            </div>
                        </div>
                    </form>

                </div>

            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>
<!-- /.content -->
@section Scripts {



}

