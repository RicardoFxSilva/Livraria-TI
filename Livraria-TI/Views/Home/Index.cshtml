                    <div class="book-title">Kepler</div>
                    <div class="price-tag">25€</div>
                    <a type="button" class="btn btn-outline-light me-2" asp-area="" asp-controller="Detalhe" asp-action="Detalhe" asp-route-id="1">Ver Livro</a>
